{$DOMAIN_NAME} {
    # Route API requests to FastAPI
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend_api:8000
    }
    
    # Route WebSocket requests for the Dev View
    handle /dev/ws/* {
        reverse_proxy backend_api:8000
    }
    
    # Route everything else to Next.js
    handle /* {
        reverse_proxy frontend:3000
    }
}
