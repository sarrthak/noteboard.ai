{$DOMAIN_NAME} {
    # Route all backend traffic (REST + WebSocket) under /api
    @openapi path *openapi.json
    handle @openapi {
        reverse_proxy backend_api:8000
    }
    
    handle /services/*{
        uri strip_prefix /services
        reverse_proxy backend_api:8000
    }

    handle /dev/ws/* {
        reverse_proxy backend_api:8000
    }

    # Route everything else to Next.js
    handle /* {
        reverse_proxy frontend:3000
    }
}
