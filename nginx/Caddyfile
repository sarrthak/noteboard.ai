{$DOMAIN_NAME} {
    # NextAuth endpoints must stay on Next.js, not FastAPI.
    @nextauth path /api/auth /api/auth/signin* /api/auth/signout* /api/auth/callback/* /api/auth/csrf /api/auth/session /api/auth/providers /api/auth/error*
    handle @nextauth {
        reverse_proxy frontend:3000
    }

    # Route all backend traffic (REST + WebSocket) under /api
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend_api:8000
    }

    # Route everything else to Next.js
    handle /* {
        reverse_proxy frontend:3000
    }
}
