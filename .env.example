# ===========================================
# noteboard.ai Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# ==================== Application ====================
APP_NAME=noteboard.ai
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# ==================== PostgreSQL ====================
POSTGRES_USER=noteboard
POSTGRES_PASSWORD=noteboard_secret
POSTGRES_DB=noteboard_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ==================== Neo4j ====================
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_URI=bolt://${NEO4J_HOST}:${NEO4J_BOLT_PORT}

# ==================== Weaviate ====================
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080
WEAVIATE_URL=http://${WEAVIATE_HOST}:${WEAVIATE_PORT}

# ==================== Celery ====================
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
